{
  "realm": "fit-bridge",
  "displayName": "FitBridge",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "CLIENT",
        "description": "FitBridge client role"
      },
      {
        "name": "TRAINER",
        "description": "FitBridge trainer role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fit-bridge-service",
      "name": "FitBridge Service",
      "rootUrl": "http://localhost:8080",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "/"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ]
    }
  ]
}
