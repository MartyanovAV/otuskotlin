# Backend Dockerfile for Kotlin/Ktor application
# Multi-stage build for optimized image size

# Stage 1: Build
FROM gradle:9.4.0-jdk21 AS builder

WORKDIR /home/gradle/project

# Copy build configuration files
COPY fit-bridge-be/settings.gradle.kts ./
COPY fit-bridge-be/build.gradle.kts ./
COPY fit-bridge-be/gradle.properties ./
COPY fit-bridge-be/fit-bridge-be-tmp/build.gradle.kts ./fit-bridge-be-tmp/

# Copy the rest of the source code
COPY fit-bridge-be/fit-bridge-be-tmp/src ./fit-bridge-be-tmp/src

# Build the application
WORKDIR /home/gradle/project/fit-bridge-be-tmp
RUN gradle build --no-daemon -x test

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy the built JAR from builder stage
COPY --from=builder /home/gradle/project/fit-bridge-be-tmp/build/libs/*.jar app.jar

# Expose application port (Ktor default)
EXPOSE 8080

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
