# ==============================================================================
# FitBridge Production Environment Template (.env.prod)
# ВНИМАНИЕ: Все пароли должны быть сгенерированы случайным образом и надежны!
# Не используйте пароли по умолчанию из локального окружения!
# ==============================================================================

# Application & Domain (HTTPS обязателен!)
GHCR_USERNAME=
APP_VERSION=
FITBRIDGE_PUBLIC_URL=https://fitbridge.example.com

# Let's Encrypt SSL Certificates
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=false

# PostgreSQL Root/Admin User
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Training Service DB User (Least Privilege DML)
DB_NAME=training_db
DB_USER=training_user
DB_PASSWORD=

# Liquibase Migration User (DDL Schema Owner)
LIQUIBASE_DB_USERNAME=liquibase
LIQUIBASE_DB_PASSWORD=

# Keycloak DB User
KC_DB_NAME=keycloak_db
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# Keycloak Bootstrap Administrator (ротируется после первоначальной настройки)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# GreptimeDB & Observability Store
GREPTIMEDB_USER=admin
GREPTIMEDB_PASS=
