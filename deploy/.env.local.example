# ==============================================================================
# FitBridge Local Development Environment Configuration (.env.local)
# Скопируйте этот файл в .env для локального запуска: cp .env.local.example .env
# ==============================================================================

# Application & Domain
APP_VERSION=local
FITBRIDGE_PUBLIC_URL=http://localhost:8080

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-password

# Training Service DB User
DB_NAME=training_db
DB_USER=training_user
DB_PASSWORD=training-password

# Liquibase Migration User
LIQUIBASE_DB_USERNAME=liquibase
LIQUIBASE_DB_PASSWORD=liquibase-password

# Keycloak DB & Admin
KC_DB_NAME=keycloak_db
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak-password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# GreptimeDB & Observability
GREPTIMEDB_USER=admin
GREPTIMEDB_PASS=admin
